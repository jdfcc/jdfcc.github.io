<style is:inline>
  .mermaid-diagram {
    margin: 1.75rem 0;
    padding: 1rem;
    overflow-x: auto;
    border: 1px solid var(--code-border);
    background: var(--code-block-bg);
  }

  .mermaid-diagram svg {
    display: block;
    width: max(100%, 40rem);
    max-width: none;
    height: auto;
    margin: 0 auto;
  }

  .mermaid-fallback {
    margin: 1.75rem 0;
  }
</style>

<script is:inline>
  (() => {
    const sources = Array.from(document.querySelectorAll('pre[data-language="mermaid"]'))
      .map((block) => ({
        block,
        source: block.textContent?.trim(),
        container: null,
      }))
      .filter((diagram) => diagram.source);

    if (sources.length === 0) return;

    let mermaid;
    let renderToken = 0;

    const renderDiagrams = async () => {
      const token = ++renderToken;
      const isDark = document.documentElement.dataset.theme === 'dark';

      mermaid.initialize({
        startOnLoad: false,
        securityLevel: 'strict',
        theme: isDark ? 'dark' : 'neutral',
      });

      for (const [index, diagram] of sources.entries()) {
        if (token !== renderToken) return;

        try {
          const { svg } = await mermaid.render(`mermaid-${token}-${index}`, diagram.source);
          if (token !== renderToken) return;

          if (!diagram.container) {
            diagram.container = document.createElement('div');
            diagram.container.className = 'mermaid-diagram';
            diagram.container.setAttribute('role', 'img');
            diagram.container.setAttribute('aria-label', 'Mermaid diagram');
            diagram.block.replaceWith(diagram.container);
          }

          diagram.container.innerHTML = svg;
        } catch (error) {
          console.error('Mermaid diagram failed to render', error);

          if (diagram.container) {
            const fallback = document.createElement('pre');
            fallback.className = 'mermaid-fallback';
            fallback.textContent = diagram.source;
            diagram.container.replaceWith(fallback);
            diagram.container = null;
          }
        }
      }
    };

    import('https://cdn.jsdelivr.net/npm/mermaid@11.12.0/dist/mermaid.esm.min.mjs')
      .then(async ({ default: mermaidModule }) => {
        mermaid = mermaidModule;
        await renderDiagrams();

        new MutationObserver(() => {
          renderDiagrams();
        }).observe(document.documentElement, {
          attributes: true,
          attributeFilter: ['data-theme'],
        });
      })
      .catch((error) => {
        console.error('Mermaid failed to load', error);
      });
  })();
</script>
