---
import "@/styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const { title = "Jdfcc", description = "随笔" } =
  Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/x-icon" href="/img/favicon.ico" />
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header">
        <div class="site-identity">
          <a class="site-brand" href="/">jdfcc</a>
          <p class="site-meta">notes, writings, experiments</p>
        </div>
        <nav class="site-nav" aria-label="主导航">
          <a href="/">index</a>
          <a href="/about/">about</a>
        </nav>
      </header>

      <main class="site-main">
        <slot />
      </main>

      <footer class="site-footer">
        <div class="site-footer-copy">
          <a class="site-footer-link" href="https://github.com/jdfcc" target="_blank" rel="noreferrer">
            <span class="site-footer-logo" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path
                  d="M12 2.6C6.809 2.6 2.6 6.809 2.6 12c0 4.152 2.693 7.675 6.429 8.918.47.087.629-.204.629-.455 0-.224-.008-.818-.013-1.605-2.615.569-3.167-1.26-3.167-1.26-.427-1.084-1.043-1.373-1.043-1.373-.853-.583.065-.571.065-.571.943.066 1.438.969 1.438.969.838 1.437 2.198 1.022 2.733.781.085-.607.328-1.022.596-1.257-2.088-.238-4.284-1.044-4.284-4.648 0-1.026.367-1.866.969-2.524-.097-.238-.42-1.196.092-2.493 0 0 .79-.253 2.59.964A8.94 8.94 0 0 1 12 7.39a8.94 8.94 0 0 1 2.359.317c1.798-1.217 2.586-.964 2.586-.964.514 1.297.191 2.255.094 2.493.604.658.967 1.498.967 2.524 0 3.613-2.2 4.407-4.295 4.64.337.291.638.866.638 1.745 0 1.26-.011 2.275-.011 2.584 0 .253.156.546.635.453A9.406 9.406 0 0 0 21.4 12c0-5.191-4.209-9.4-9.4-9.4Z"
                  fill="currentColor"
                />
              </svg>
            </span>
            <span class="site-footer-text">github</span>
          </a>
        </div>
      </footer>
    </div>
  </body>
</html>
