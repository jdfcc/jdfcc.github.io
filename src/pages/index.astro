---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HomeSection from '@/components/HomeSection.astro';
import Analytics from '@/components/Analytics.astro';
import { getAllPosts, getHomeSections } from '@/lib/posts';

const posts = await getAllPosts();
const sections = getHomeSections(posts);
const latestUpdated = posts[0]?.data.created;
---

<BaseLayout title="Jdfcc">
  <div class="home-layout">
    <aside class="home-sidebar" aria-label="页面导航" data-mobile-drawer>
      <div class="home-sidebar-sticky">
         <div class="home-sidebar-block home-sidebar-meta">
          <p><span>{posts.length}</span> 篇文章</p>
          {latestUpdated && <p>最近更新 {latestUpdated.toLocaleDateString('zh-CN')}</p>}
        </div>

        <nav class="home-sidebar-block home-sidebar-nav" aria-label="分区目录">
          <p class="eyebrow">sections</p>
          <ul>
            {sections.map((section, index) => (
              <li>
                <a href={`#${section.id}`} data-home-nav-link={`#${section.id}`}>{String(index + 1).padStart(2, '0')} {section.name}</a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </aside>

    <div class="home-main-column">
      <section class="home-hero">
        <p class="eyebrow">index</p>
        <h1>All Content</h1>
        <p class="home-intro">技术实践、工具记录与持续更新的个人知识索引。</p>
        <label class="home-search">
          <span class="visually-hidden">筛选文章</span>
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none">
            <circle cx="11" cy="11" r="6.5"></circle>
            <path d="m16 16 4 4"></path>
          </svg>
          <input type="search" placeholder="筛选标题、摘要或分区…" autocomplete="off" data-home-search />
          <span class="home-search-count" aria-live="polite" data-home-search-count>{posts.length}</span>
        </label>
      </section>

      <div class="home-mobile-search">
        <label class="home-search">
          <span class="visually-hidden">筛选文章</span>
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none">
            <circle cx="11" cy="11" r="6.5"></circle>
            <path d="m16 16 4 4"></path>
          </svg>
          <input type="search" placeholder="筛选文章…" autocomplete="off" data-home-search />
          <span class="home-search-count" aria-live="polite" data-home-search-count>{posts.length}</span>
        </label>
      </div>

      <div class="home-sections">
        {sections.map((section, index) => <HomeSection section={section} index={index} />)}
      </div>
      <p class="home-empty" hidden data-home-empty>没有匹配的文章，试试更短的关键词。</p>
    </div>
  </div>

  <Analytics />

  <script is:inline>
    const homeSearchInputs = Array.from(document.querySelectorAll('[data-home-search]'));
    const homeSearchCounts = Array.from(document.querySelectorAll('[data-home-search-count]'));
    const homePostItems = Array.from(document.querySelectorAll('[data-home-post]'));
    const homeEmpty = document.querySelector('[data-home-empty]');

    const normalizeHomeSearch = (value) => value.trim().toLocaleLowerCase('zh-CN');

    const filterHomePosts = (value, source) => {
      const query = normalizeHomeSearch(value);
      let visibleCount = 0;

      homeSearchInputs.forEach((input) => {
        if (input !== source) input.value = value;
      });

      homePostItems.forEach((item) => {
        const visible = !query || normalizeHomeSearch(item.dataset.search ?? '').includes(query);
        item.hidden = !visible;
        if (visible) visibleCount += 1;
      });

      document.querySelectorAll('[data-home-section]').forEach((section) => {
        section.hidden = !section.querySelector('[data-home-post]:not([hidden])');
      });

      homeSearchCounts.forEach((count) => (count.textContent = String(visibleCount)));
      if (homeEmpty) homeEmpty.hidden = visibleCount !== 0;
    };

    homeSearchInputs.forEach((input) => {
      input.addEventListener('input', () => filterHomePosts(input.value, input));
    });

    const homeSections = Array.from(document.querySelectorAll('[data-home-section]'));
    const homeLinks = new Map(
      Array.from(document.querySelectorAll('[data-home-nav-link]')).map((link) => [link.getAttribute('data-home-nav-link'), link]),
    );

    if (homeSections.length > 0 && homeLinks.size > 0) {
      let homeLockedId = null;
      let homeUnlockTimer = null;
      let isHomeScrolling = false;

      const setActiveHomeSection = (id) => {
        homeLinks.forEach((link, key) => {
          link.classList.toggle('is-active', key === `#${id}`);
        });
      };

      const lockHomeActiveState = (id) => {
        homeLockedId = id;
        window.clearTimeout(homeUnlockTimer);
        homeUnlockTimer = window.setTimeout(() => {
          homeLockedId = null;
        }, 420);
      };

      const scrollToHomeSection = (id) => {
        const target = document.getElementById(id);
        if (!target || isHomeScrolling) return;
        isHomeScrolling = true;
        setActiveHomeSection(id);
        lockHomeActiveState(id);
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        history.replaceState(null, '', `#${id}`);
        window.setTimeout(() => {
          isHomeScrolling = false;
        }, 460);
      };

      homeLinks.forEach((link, key) => {
        const id = key?.slice(1);
        if (!id) return;
        link.addEventListener('click', (event) => {
          event.preventDefault();
          scrollToHomeSection(id);
        });
      });

      const homeObserver = new IntersectionObserver(
        (entries) => {
          if (homeLockedId) {
            setActiveHomeSection(homeLockedId);
            return;
          }

          const visible = entries
            .filter((entry) => entry.isIntersecting)
            .sort((left, right) => right.intersectionRatio - left.intersectionRatio)[0];

          if (visible?.target?.id) {
            setActiveHomeSection(visible.target.id);
          }
        },
        {
          rootMargin: '-18% 0px -58% 0px',
          threshold: [0.15, 0.35, 0.6],
        },
      );

      homeSections.forEach((section) => homeObserver.observe(section));

      const initialHomeId = window.location.hash?.slice(1);
      if (initialHomeId && document.getElementById(initialHomeId)) {
        setActiveHomeSection(initialHomeId);
      } else {
        setActiveHomeSection(homeSections[0].id);
      }
    }
  </script>
</BaseLayout>
